# KnowMesh Environment Configuration (.env.example)

# Core Application Settings
KNOWMESH_APP_NAME="KnowMesh API"
KNOWMESH_ENVIRONMENT="development"
KNOWMESH_API_PREFIX="/api/v1"

# Independent Node Identity
KNOWMESH_NODE_ID="node-a"
KNOWMESH_NODE_NAME="Alpha Research Node"
KNOWMESH_NODE_ENDPOINT="http://127.0.0.1:8000"

# Persistence (PostgreSQL in production / SQLite for zero-config local dev)
KNOWMESH_DATABASE_URL="postgresql+psycopg2://knowmesh:knowmesh@localhost:5432/knowmesh"
# Fallback for local single-binary run:
# KNOWMESH_DATABASE_URL="sqlite:///./knowmesh.db"

# Security & Session Token Signing
KNOWMESH_SECRET_KEY="replace-with-strong-32-byte-hmac-secret-in-production"
KNOWMESH_ACCESS_TOKEN_TTL="3600"
KNOWMESH_REFRESH_TOKEN_TTL="86400"
KNOWMESH_MAX_REQUEST_BYTES="2097152"
KNOWMESH_ALLOW_LOCAL_PEERS="true"

# Next.js Organization Console & Developer Portal
NEXT_PUBLIC_KNOWMESH_API_URL="http://localhost:8000"

